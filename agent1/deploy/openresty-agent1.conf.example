# OpenResty / edge snippet for public agent1.izhon.ru
#
# Edge = LAN gateway 192.168.111.5 (openresty), public IP 78.85.39.236.
# demosah.izhon.ru already has a vhost there (X-Served-By). agent1 DNS
# already points to 78.85.39.236 but returns 404 until this block is added.
# Do NOT edit demosah vhost. izhon itself already serves agent1 on :80.
#
# Upstream: izhon LAN 192.168.111.59:80

server {
    listen 80;
    server_name agent1.izhon.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name agent1.izhon.ru;

    # reuse same cert strategy as demosah (wildcard or dedicated SAN)
    # ssl_certificate     /path/to/izhon.ru/fullchain.pem;
    # ssl_certificate_key /path/to/izhon.ru/privkey.pem;

    location / {
        proxy_pass http://192.168.111.59:80;
        proxy_http_version 1.1;
        proxy_set_header Host agent1.izhon.ru;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        add_header X-Served-By agent1.izhon.ru always;
    }
}
