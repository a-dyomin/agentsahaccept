# Copy to .env and fill. Do not commit .env.

# Selectel S3 (photos)
S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=main
S3_ACCESS_KEY=
S3_SECRET_KEY=
# set false if corporate proxy breaks Selectel TLS
S3_VERIFY_SSL=true

# Greta SSH (read-only probes / tunnel)
GRETA_SSH_HOST=greta.akea-ds.ru
GRETA_SSH_PORT=34023
GRETA_SSH_USER=gretaadmin
GRETA_SSH_KEY=~/.ssh/greta2_migration_ed25519

# Optional: Postgres via SSH tunnel (fill after DBA confirms)
# GRETA_DB_HOST=127.0.0.1
# GRETA_DB_PORT=5432
# GRETA_DB_NAME=greta_backend_production
# GRETA_DB_USER=
# GRETA_DB_PASSWORD=

# Stage 1 thresholds (TZ 4.8 — pending Vasilyeva confirmation)
PHOTO_RADIUS_M=200
TRACK_RADIUS_M=200
NO_PICKUP_TRACK_RADIUS_M=300
PHOTO_NEAR_ARRIVAL_M=100
TIME_TOLERANCE_MIN=7
NO_PICKUP_TIME_TOLERANCE_MIN=5
TRACK_SEARCH_WINDOW_MIN=30
